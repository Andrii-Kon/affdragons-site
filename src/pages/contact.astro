---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import mainHtml from "../pages-content/contact.html?raw";
import footerHtml from "../footer.html?raw";
const cssBundle = "/wp-content/cache/min/1/4b8333796a4001b3cd3ff203bf29a30d.css";
---
<Base title={"Contact - Affiliate Dragons"} description={"Contact Us Simply fill out the form or email us at"} cssBundle={cssBundle} inlineCss="/assets/home-inline.css" lang="en" canonical="https://affdragons.com/contact/">
  <SiteHeader slot="header" lang="en" active="contact" />
  <Fragment set:html={mainHtml} />
  <Fragment slot="footer" set:html={footerHtml} />
</Base>
