---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import mainHtml from "../pages-content/advertisers.html?raw";
import footerHtml from "../footer.html?raw";
const cssBundle = "/wp-content/cache/min/1/fe967182ddc5d056fbcc48e2f546b6fb.css";
---
<Base title={"For Advertisers - Affiliate Dragons"} description={"Advertisers"} cssBundle={cssBundle} inlineCss="/assets/home-inline.css" lang="en" canonical="https://affdragons.com/advertisers/">
  <SiteHeader slot="header" lang="en" />
  <Fragment set:html={mainHtml} />
  <Fragment slot="footer" set:html={footerHtml} />
</Base>
