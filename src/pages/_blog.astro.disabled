---
// Disabled: Blog migration is parked until approved.
// Restore as src/pages/blog.astro to publish the archive route.
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import mainHtml from "../pages-content/blog.html?raw";
import footerHtml from "../footer.html?raw";
const cssBundle = "/wp-content/cache/min/1/c4342bfa18cb1486221907ffe8b49792.css";
---
<Base title={"Blog - Affiliate Dragons"} description={"Performance marketing agency"} cssBundle={cssBundle} inlineCss="/assets/home-inline.css" lang="en" canonical="https://affdragons.com/blog/">
  <SiteHeader slot="header" lang="en" active="blog" />
  <Fragment set:html={mainHtml} />
  <Fragment slot="footer" set:html={footerHtml} />
</Base>
